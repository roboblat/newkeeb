/*
 * DONGLE = split CENTRAL, keyless, USB. Runs the keymap and both trackpad
 * listeners: LEFT pad -> scroll, RIGHT pad -> pointer (with acceleration).
 * No matrix, no trackpad, no battery - it's a bare XIAO on USB.
 */

#include "newkeeb.dtsi"
#include <behaviors/input_gestures_accel.dtsi>   /* provides the default &pointer_accel node */

/ {
    /* The central has no keys of its own -> mock kscan. */
    chosen {
        zmk,kscan = &mock_kscan;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};

/* Velocity-based pointer acceleration, on the POINTER listener only. Factors in
 * thousandths (1000 = 1.0x). Tune to taste. */
&pointer_accel {
    #input-processor-cells = <0>;
    input-type = <INPUT_EV_REL>;
    min-factor = <800>;          /* 0.8x when slow -> fine aim */
    max-factor = <3000>;         /* 3.0x on fast flicks */
    speed-threshold = <1200>;
    speed-max = <6000>;
    acceleration-exponent = <2>;
    track-remainders;
};

/* LEFT pad -> scroll. */
&left_scroll_listener {
    status = "okay";
};

/* RIGHT pad -> pointer, with acceleration. */
&right_pointer_listener {
    status = "okay";
    input-processors = <&pointer_accel>;
};
