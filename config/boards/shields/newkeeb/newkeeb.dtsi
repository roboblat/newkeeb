/*
 * newKeeb - shared by ALL THREE parts (dongle + left + right).
 *
 * Only what every part must agree on: the matrix transform (ZMK requires it
 * identical on all parts) and the split-input proxies. Everything else is
 * part-specific:
 *   - matrix + i2c + trackpad                     -> newkeeb_half.dtsi (halves)
 *   - mock kscan + input processors + listeners   -> newkeeb_dongle.overlay
 *
 * The input processors (scroll mapper etc.) live ONLY on the dongle: ZMK's
 * processors.dtsi references keymap behaviors (&none) that exist only where
 * there is a keymap - i.e. the central. Pulling it onto the keyless peripherals
 * is what caused the "undefined node label 'none'" error.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,matrix-transform = &default_transform;
        zmk,physical-layout = &physical_layout0;
    };

    /* Combined 4x10 transform. Left half = cols 0-4, right half = cols 5-9
     * (the right peripheral sets col-offset = <5> in its overlay). */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)    RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
    };

    /*
     * Split input proxies. Each half binds its local trackpad to one of these in
     * its overlay; the dongle attaches a listener to each. On the dongle these
     * stay device-less (they are the remote proxies).
     */
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        /*
         * Disabled by default. A peripheral must give any ENABLED input-split a
         * `device`, so each half enables only its own (with device) in its
         * overlay; the dongle enables both as device-less receive proxies.
         */
        left_input: left_input@0 {
            compatible = "zmk,input-split";
            reg = <0>;
            status = "disabled";
        };
        right_input: right_input@1 {
            compatible = "zmk,input-split";
            reg = <1>;
            status = "disabled";
        };
    };
};
