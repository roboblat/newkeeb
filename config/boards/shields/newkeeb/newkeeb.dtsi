/*
 * newKeeb - shared by ALL THREE parts (dongle + left + right).
 *
 * Contains only what every part must agree on: the matrix transform and the
 * split-input plumbing. (ZMK requires the transform to exist identically on
 * every part of a split.) Per-half hardware (matrix + i2c + trackpad) lives in
 * newkeeb_half.dtsi; the dongle's mock kscan + listeners live in the dongle overlay.
 *
 *   DONGLE = central, keyless, USB. Runs the keymap + both trackpad listeners.
 *   LEFT   = peripheral. Matrix + trackpad -> SCROLL  (forwarded to the dongle).
 *   RIGHT  = peripheral. Matrix + trackpad -> POINTER (forwarded to the dongle).
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>

/ {
    chosen {
        zmk,matrix-transform = &default_transform;
    };

    /* Combined 4x10 transform. Left half = cols 0-4, right half = cols 5-9
     * (the right peripheral sets col-offset = <5> in its overlay). */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)    RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    /*
     * Split input proxies. Each half binds its local trackpad to one of these in
     * its overlay; the dongle enables the matching listener. On the dongle these
     * stay device-less (they are the remote proxies).
     */
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        left_input: left_input@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
        right_input: right_input@1 {
            compatible = "zmk,input-split";
            reg = <1>;
        };
    };

    /* Scroll scaler: divide wheel deltas into 1/64..1/128 and keep remainders. */
    scroll_scaler: scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };

    /* Both listeners run on the DONGLE. Enabled in newkeeb_dongle.overlay. */
    left_scroll_listener: left_scroll_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&left_input>;
        input-processors = <&zip_xy_to_scroll_mapper &scroll_scaler 1 96>;
    };
    right_pointer_listener: right_pointer_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&right_input>;
        /* pointer acceleration is attached on the dongle */
    };
};
